// Keep include/exclude/paths out of this file. `extends` inherits them, so they would leak
// into every package's file scope. The root project keeps its own tsconfig.json.
{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],

    "module": "preserve",
    "moduleResolution": "bundler",

    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "types": []
  }
}
