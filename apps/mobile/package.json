{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_PUBLIC_APP_VARIANT=development expo start",
    "android:prod": "EXPO_PUBLIC_APP_VARIANT=production expo run:android --variant release",
    "android:dev": "EXPO_PUBLIC_APP_VARIANT=development expo run:android --variant debug",
    "ios:prod": "EXPO_PUBLIC_APP_VARIANT=production expo run:ios --configuration Release",
    "ios:dev": "EXPO_PUBLIC_APP_VARIANT=development expo run:ios --configuration Debug",
    "prebuild:prod": "EXPO_PUBLIC_APP_VARIANT=production expo prebuild",
    "prebuild:dev": "EXPO_PUBLIC_APP_VARIANT=development expo prebuild",
    "lint": "oxlint --type-aware --fix && oxfmt",
    "format": "oxfmt",
    "type-check": "tsc --noEmit",
    "check": "concurrently --group --prefix none 'pnpm run lint' 'pnpm run type-check'"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo/ui": "~58.0.6",
    "@t3-oss/env-core": "catalog:",
    "@tanstack/react-query": "^5.103.1",
    "backend": "workspace:*",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "expo": "58.0.0-preview.6",
    "expo-asset": "~58.0.6",
    "expo-blur": "~58.0.1",
    "expo-constants": "~58.0.6",
    "expo-dev-client": "~58.0.6",
    "expo-font": "~58.0.2",
    "expo-image": "~58.0.5",
    "expo-linear-gradient": "~58.0.1",
    "expo-linking": "~58.0.6",
    "expo-localization": "~58.0.1",
    "expo-network": "~58.0.1",
    "expo-router": "~58.0.7",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.1",
    "expo-status-bar": "~58.0.1",
    "expo-symbols": "~58.0.2",
    "expo-system-ui": "~58.0.2",
    "hono": "catalog:",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.13",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.12.2",
    "uniwind": "^1.12.0",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-expo": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.5.1"
}
